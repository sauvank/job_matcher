APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-this-production-secret
DEFAULT_URI=https://jobs.example.com

APP_HTTP_PORT=8081
PROD_ENV_FILE=.env.prod.example
PHP_IMAGE=job-matcher-php:prod
NGINX_IMAGE=job-matcher-nginx:prod

POSTGRES_DB=job_matcher
POSTGRES_USER=job_matcher
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://job_matcher:change-this-database-password@database:5432/job_matcher?serverVersion=16&charset=utf8

LOCK_DSN=redis://redis:6379/0
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
SESSION_REDIS_DSN=redis://redis:6379/1

CV_ANALYZER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
JOB_OPENAI_MODEL=gpt-5.6-luna

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
