# Copy this file to .env.local. Never commit .env.local.

# --- Option 1 : Google Gemini (Gratuit via https://aistudio.google.com/) ---
CV_ANALYZER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
JOB_GEMINI_MODEL=gemini-2.0-flash

# --- Option 2 : OpenAI (Payant à l'usage) ---
# CV_ANALYZER=openai
# OPENAI_API_KEY=replace-with-your-project-api-key
# OPENAI_MODEL=gpt-4.1-mini
# JOB_OPENAI_MODEL=gpt-5.6-luna

# --- Option 3 : Faux analyseur local (Gratuit sans clé API) ---
# CV_ANALYZER=fake

GOOGLE_CLIENT_ID=ton-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ton-client-secret


