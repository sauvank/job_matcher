{% extends 'base.html.twig' %}

{% block title %}Déposer mon CV · Job Matcher{% endblock %}

{% block body %}
    <div class="page-heading">
        <p class="eyebrow">Profil candidat</p>
        <h1>Déposer un CV</h1>
        <p>Le texte est extrait localement, puis analysé en arrière-plan. Rien ne sera appliqué au profil sans votre validation.</p>
    </div>

    <section class="card upload-card">
        {{ form_start(form, {attr: {'data-controller': 'file-upload'}}) }}
            <div class="upload-field">
                {{ form_widget(form.file, {attr: {
                    class: 'upload-input',
                    accept: '.pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                    'data-file-upload-target': 'input',
                    'data-action': 'change->file-upload#update'
                }}) }}
                <label
                    class="upload-zone"
                    for="{{ form.file.vars.id }}"
                    data-file-upload-target="zone"
                    data-action="dragover->file-upload#dragOver dragleave->file-upload#dragLeave drop->file-upload#drop"
                >
                    <span class="upload-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5"/>
                            <path d="M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/>
                        </svg>
                    </span>
                    <span class="upload-title">Déposez votre CV ici</span>
                    <span class="upload-copy">ou <strong>parcourez vos fichiers</strong></span>
                    <span class="upload-meta">PDF ou DOCX · 10 Mo maximum · stockage privé</span>
                    <span class="upload-filename" data-file-upload-target="filename">Aucun fichier sélectionné</span>
                </label>
                {{ form_errors(form.file) }}
            </div>
            <div class="upload-actions">
                {{ form_widget(form.submit, {attr: {'data-file-upload-target': 'submit'}}) }}
                <span>Le texte est extrait localement avant l’analyse.</span>
            </div>
            {{ form_rest(form) }}
        {{ form_end(form) }}
    </section>

    {% if profile and profile.cvDocuments|length > 0 %}
        <section class="section">
            <h2>Historique des CV</h2>
            <div class="document-list">
                {% for document in profile.cvDocuments %}
                    {% set isProcessing = document.status.value in ['UPLOADED', 'EXTRACTING', 'ANALYZING'] %}
                    <div class="document-row" id="cv-document-{{ document.id }}">
                        <a class="document-row-link" href="{{ path('app_cv_show', {id: document.id}) }}">
                            <span>{{ document.originalFilename }}</span>
                            <span class="badge">{{ ('candidate.cv.status.' ~ document.status.value|lower)|trans }}</span>
                        </a>
                        <form method="post" action="{{ path('app_cv_delete', {id: document.id}) }}" data-turbo-confirm="Supprimer ce CV et son analyse ?">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-cv-' ~ document.id) }}">
                            <button class="button danger button-compact" type="submit" {{ isProcessing ? 'disabled' : '' }} title="{{ isProcessing ? 'Suppression disponible après la fin de l’analyse' : 'Supprimer ce CV' }}">Supprimer</button>
                        </form>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
