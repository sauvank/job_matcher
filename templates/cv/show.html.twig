{% extends 'base.html.twig' %}

{% block title %}Analyse du CV · Job Matcher{% endblock %}

{% block body %}
    {% set isProcessing = document.status.value in ['UPLOADED', 'EXTRACTING', 'ANALYZING'] %}
    <turbo-frame id="cv-show-frame" target="_top" {% if isProcessing %}data-controller="poll" data-poll-interval-value="2000" data-poll-url-value="{{ path('app_cv_show', {id: document.id}) }}"{% endif %}>
    <div class="page-heading">
        <p class="eyebrow">Analyse du CV</p>
        <h1>{{ document.originalFilename }}</h1>
        <p>
            Statut : <span class="badge">{{ ('candidate.cv.status.' ~ document.status.value|lower)|trans }}</span>
            {% if document.candidateProfile.activeCvDocument == document %}· <span class="badge">CV actif</span>{% endif %}
            {% if document.analyzer %}· {{ document.analyzer }}{% endif %}
        </p>
        <div class="button-row">
            <a class="button secondary" href="{{ path('app_cv_file', {id: document.id}) }}" target="_blank" rel="noopener noreferrer">📄 Voir le document original ↗</a>
            {% if document.hasAppliedProfile and document.candidateProfile.activeCvDocument != document %}
                <form method="post" action="{{ path('app_cv_activate', {id: document.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('activate-cv-' ~ document.id) }}">
                    <button class="button secondary" type="submit">Utiliser ce CV</button>
                </form>
            {% endif %}
            {% if document.status.value in ['READY', 'APPLIED', 'FAILED'] %}
                <form method="post" action="{{ path('app_cv_reanalyze', {id: document.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('reanalyze-cv-' ~ document.id) }}">
                    <button class="button secondary" type="submit">Relancer l’analyse</button>
                </form>
            {% endif %}
        </div>
    </div>

    {% if document.status.value in ['UPLOADED', 'EXTRACTING', 'ANALYZING'] %}
        <section class="card">
            <h2>Traitement en cours</h2>
            <div class="progress-block">
                <div class="progress-label">
                    <span>{{ ('candidate.cv.status.' ~ document.status.value|lower)|trans }}</span>
                    <strong>{{ document.processingProgress }} %</strong>
                </div>
                <progress max="100" value="{{ document.processingProgress }}">{{ document.processingProgress }} %</progress>
            </div>
            <p>Le worker extrait le texte et prépare l'analyse. Rechargez cette page dans quelques instants.</p>
            <a class="button" href="{{ path('app_cv_show', {id: document.id}) }}">Actualiser</a>
        </section>
    {% elseif document.status.value == 'FAILED' %}
        <section class="card error-card">
            <h2>Analyse impossible</h2>
            <p>{{ document.errorMessage|trans }}</p>
            <a href="{{ path('app_cv_upload') }}">Déposer un autre CV</a>
        </section>
    {% elseif analysis %}
        <section class="card">
            <h2>Résumé proposé</h2>
            <p>{{ analysis.summary }}</p>
            {% if analysis.warnings %}
                <ul>{% for warning in analysis.warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
            {% endif %}
        </section>

        {% if reviewForm %}
            <section class="card form-card">
                <h2>{{ document.status.value == 'APPLIED' ? 'Réutiliser ce CV' : 'Vérifiez avant d’appliquer' }}</h2>
                <p>Les informations et compétences sélectionnées remplaceront celles du profil actif.</p>
                {{ form_start(reviewForm) }}
                    {{ form_row(reviewForm.title) }}
                    {{ form_row(reviewForm.location) }}
                    {{ form_row(reviewForm.yearsOfExperience) }}
                    <div class="cv-review-contracts">
                        <span class="form-section-label">Type(s) de contrat recherché(s)</span>
                        <p class="help-text">Sélectionnez les contrats qui vous correspondent (CDI, Freelance, CDD, Alternance, Stage).</p>
                        <div class="contract-choice-grid">
                            {% for choice in reviewForm.contractTypes %}
                                <label class="contract-choice" for="{{ choice.vars.id }}">
                                    {{ form_widget(choice) }}
                                    <span>{{ choice.vars.label }}</span>
                                </label>
                            {% endfor %}
                        </div>
                        {{ form_errors(reviewForm.contractTypes) }}
                        {% do reviewForm.contractTypes.setRendered %}
                    </div>
                    <div class="cv-review-skills">
                        <span class="form-section-label">Compétences à conserver</span>
                        <p>Décochez une compétence si elle ne doit pas rejoindre votre profil. Le niveau proposé pourra être ajusté ensuite dans « Mes compétences ».</p>
                        <div class="cv-skill-choice-grid">
                            {% for choice in reviewForm.selectedSkills %}
                                {% set skillMetadata = null %}
                                {% for analyzedSkill in analysis.skills %}
                                    {% if analyzedSkill.name == choice.vars.value %}{% set skillMetadata = analyzedSkill %}{% endif %}
                                {% endfor %}
                                <label class="cv-skill-choice" for="{{ choice.vars.id }}">
                                    {{ form_widget(choice) }}
                                    <span>
                                        <strong>{{ choice.vars.label }}</strong>
                                        {% if skillMetadata %}
                                            <small>{{ skillMetadata.category.label() }} · {{ skillMetadata.level ? skillMetadata.level.label() : 'Niveau à préciser' }}</small>
                                        {% endif %}
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                        {{ form_errors(reviewForm.selectedSkills) }}
                        {% do reviewForm.selectedSkills.setRendered %}
                    </div>
                    {{ form_row(reviewForm.apply) }}
                {{ form_end(reviewForm) }}
            </section>
        {% endif %}
    {% endif %}

    {% if document.status.value not in ['UPLOADED', 'EXTRACTING'] %}
        {% if document.mimeType == 'application/pdf' or document.originalFilename ends with '.pdf' %}
            <section class="card cv-preview-card">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Document original</p>
                        <h2>Aperçu du CV</h2>
                    </div>
                    <a class="button button-compact secondary" href="{{ path('app_cv_file', {id: document.id}) }}" target="_blank" rel="noopener noreferrer">Ouvrir en plein écran ↗</a>
                </div>
                <div class="cv-pdf-viewer-wrap">
                    <iframe src="{{ path('app_cv_file', {id: document.id}) }}" class="cv-pdf-frame" title="Aperçu du CV {{ document.originalFilename }}"></iframe>
                </div>
            </section>
        {% endif %}

        {% if document.extractedText %}
            <details class="optimization-disclosure cv-text-disclosure">
                <summary>
                    <span class="disclosure-indicator" aria-hidden="true"></span>
                    <div>
                        <h3>Texte brut extrait</h3>
                        <p>Contenu textuel lu et analysé par l’application</p>
                    </div>
                    <span class="disclosure-chevron" aria-hidden="true">▼</span>
                </summary>
                <div class="cv-raw-text-block">
                    <pre>{{ document.extractedText }}</pre>
                </div>
            </details>
        {% endif %}
    {% endif %}
    </turbo-frame>
{% endblock %}
