{% extends 'base.html.twig' %}

{% block title %}Offres importées · Job Matcher{% endblock %}

{% block body %}
    <div class="page-heading">
        <p class="eyebrow">Collecte</p>
        <h1>Offres importées</h1>
        <p>{{ offers|length }} offre(s) enregistrée(s). Le score de compatibilité sera ajouté au prochain incrément.</p>
    </div>

    <section class="card">
        {% if offers is empty %}
            <p>Aucune offre importée. <a href="{{ path('app_job_sources') }}">Ajoutez une source</a>.</p>
        {% else %}
            <div class="table-wrapper">
                <table>
                    <thead><tr><th>Titre</th><th>Entreprise</th><th>Localisation</th><th>Contrat</th><th>Salaire</th><th>Publication</th></tr></thead>
                    <tbody>
                    {% for offer in offers %}
                        <tr>
                            <td><a href="{{ offer.url }}" target="_blank" rel="noopener noreferrer">{{ offer.title }}</a></td>
                            <td>{{ offer.company ?? 'Non renseignée' }}</td>
                            <td>{{ offer.location ?? 'Non renseignée' }}</td>
                            <td>{{ offer.contractType ?? 'Non renseigné' }}</td>
                            <td>
                                {% if offer.minimumSalary or offer.maximumSalary %}
                                    {{ offer.minimumSalary ? offer.minimumSalary|number_format(0, ',', ' ') : '?' }}
                                    – {{ offer.maximumSalary ? offer.maximumSalary|number_format(0, ',', ' ') : '?' }} €
                                {% else %}Non renseigné{% endif %}
                            </td>
                            <td>{{ offer.publishedAt ? offer.publishedAt|date('d/m/Y') : 'Inconnue' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
