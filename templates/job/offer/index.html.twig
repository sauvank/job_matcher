{% extends 'base.html.twig' %}

{% block title %}Offres importées · Job Matcher{% endblock %}

{% block body %}
    {% set providerLabels = {
        'FAKE': 'Démonstration',
        'HELLOWORK': 'HelloWork',
        'INDEED': 'Indeed',
        'APEC': 'Apec',
        'FRANCE_TRAVAIL': 'France Travail',
        'WELCOME_TO_THE_JUNGLE': 'Welcome to the Jungle'
    } %}
    <div data-controller="offer-filter">
    <div class="page-heading page-heading-actions">
        <div>
            <p class="eyebrow">Vos opportunités</p>
            <h1>Offres analysées</h1>
            {% if (currentView ?? 'ranked') == 'latest' %}
                <p><span data-offer-filter-target="count">{{ matches|length }}</span> offre(s), classée(s) par date de découverte la plus récente.</p>
            {% else %}
                <p><span data-offer-filter-target="count">{{ matches|length }}</span> offre(s), classée(s) selon la compatibilité calculée par l’IA.</p>
            {% endif %}
        </div>
        <a class="button secondary" href="{{ path('app_job_sources') }}">Gérer les sources</a>
    </div>

    <div class="view-tabs" role="tablist" aria-label="Mode de classement des offres">
        <a href="{{ path('app_job_offers', {view: 'ranked'}) }}" class="view-tab {{ (currentView ?? 'ranked') == 'ranked' ? 'active' : '' }}" role="tab" aria-selected="{{ (currentView ?? 'ranked') == 'ranked' ? 'true' : 'false' }}">
            <span aria-hidden="true">🎯</span> Meilleurs scores
        </a>
        <a href="{{ path('app_job_offers', {view: 'latest'}) }}" class="view-tab {{ (currentView ?? 'ranked') == 'latest' ? 'active' : '' }}" role="tab" aria-selected="{{ (currentView ?? 'ranked') == 'latest' ? 'true' : 'false' }}">
            <span aria-hidden="true">⏱️</span> Dernières annonces trouvées
        </a>
    </div>

    {% if hasPendingAnalysis %}
        <div class="analysis-pending-banner card" data-controller="poll" data-poll-interval-value="3000">
            <span class="spinner-sm" aria-hidden="true"></span>
            <div>
                <strong>Analyse IA en cours :</strong>
                <span>De nouvelles offres sont actuellement analysées en arrière-plan. Cette page se met à jour automatiquement dès que les scores sont prêts.</span>
            </div>
        </div>
    {% endif %}

    {% if matches is empty %}
        <section class="card empty-state">
            <span class="empty-state-icon" aria-hidden="true">⌕</span>
            <p>Aucune offre importée. <a href="{{ path('app_job_sources') }}">Configurez ou synchronisez vos sources</a> pour rechercher des opportunités.</p>
        </section>
    {% else %}
        {% set providers = [] %}
        {% for match in matches %}
            {% set provider = match.jobOffer.source.provider.value %}
            {% if provider not in providers %}
                {% set providers = providers|merge([provider]) %}
            {% endif %}
        {% endfor %}
        <div class="filter-toolbar">
            <div class="filter-toolbar-left">
                <details class="filter-dropdown" data-offer-filter-target="dropdown">
                    <summary class="filter-dropdown-btn">
                        <span aria-hidden="true">⚙️</span>
                        <span>Filtres & Sources</span>
                        <span class="filter-dropdown-badge" data-offer-filter-target="activeBadge" hidden>0</span>
                        <span class="filter-dropdown-arrow" aria-hidden="true">▾</span>
                    </summary>
                    <div class="filter-dropdown-menu">
                        <div class="filter-dropdown-header">
                            <strong>Filtres avancés</strong>
                            <button type="button" class="filter-dropdown-reset" data-action="offer-filter#resetDropdown">Réinitialiser</button>
                        </div>
                        <div class="filter-dropdown-section">
                            <span class="filter-dropdown-title">Masquage rapide</span>
                            <label class="filter-dropdown-item">
                                <input type="checkbox" data-offer-filter-target="excludeNotInterested" data-action="change->offer-filter#updateFilters">
                                <span>🚫 Masquer « Ne m’intéresse pas »</span>
                            </label>
                            <label class="filter-dropdown-item">
                                <input type="checkbox" data-offer-filter-target="excludeEsn" data-action="change->offer-filter#updateFilters">
                                <span>💼 Masquer les ESN</span>
                            </label>
                        </div>
                        <div class="filter-dropdown-section">
                            <div class="filter-dropdown-section-head">
                                <span class="filter-dropdown-title">Compatibilité minimale</span>
                                <span class="filter-dropdown-score-value" data-offer-filter-target="minScoreLabel">Toutes (0%)</span>
                            </div>
                            <div class="filter-dropdown-slider-wrap">
                                <input type="range" min="0" max="95" step="5" value="0" class="filter-score-slider" data-offer-filter-target="minScore" data-action="input->offer-filter#updateFilters">
                                <div class="filter-dropdown-presets">
                                    <button type="button" class="filter-preset-btn is-active" data-offer-filter-target="presetBtn" data-action="offer-filter#setMinScorePreset" data-score="0">Toutes</button>
                                    <button type="button" class="filter-preset-btn" data-offer-filter-target="presetBtn" data-action="offer-filter#setMinScorePreset" data-score="50">≥ 50%</button>
                                    <button type="button" class="filter-preset-btn" data-offer-filter-target="presetBtn" data-action="offer-filter#setMinScorePreset" data-score="70">≥ 70%</button>
                                    <button type="button" class="filter-preset-btn" data-offer-filter-target="presetBtn" data-action="offer-filter#setMinScorePreset" data-score="80">≥ 80%</button>
                                </div>
                            </div>
                        </div>
                        {% if providers is not empty %}
                            <div class="filter-dropdown-section">
                                <div class="filter-dropdown-section-head">
                                    <span class="filter-dropdown-title">Sources & Plateformes</span>
                                    <div class="filter-dropdown-quick-links">
                                        <button type="button" data-action="offer-filter#checkAllSources">Toutes</button>
                                        <span>·</span>
                                        <button type="button" data-action="offer-filter#uncheckAllSources">Aucune</button>
                                    </div>
                                </div>
                                <div class="filter-dropdown-grid">
                                    {% for provider in providers %}
                                        <label class="filter-dropdown-item">
                                            <input type="checkbox" value="{{ provider }}" data-offer-filter-target="sourceCheckbox" data-action="change->offer-filter#updateFilters" checked>
                                            <span>{{ providerLabels[provider] ?? provider }}</span>
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        <div class="filter-dropdown-section">
                            <div class="filter-dropdown-section-head">
                                <span class="filter-dropdown-title">Statuts de candidature</span>
                                <div class="filter-dropdown-quick-links">
                                    <button type="button" data-action="offer-filter#checkAllStatuses">Tous</button>
                                    <span>·</span>
                                    <button type="button" data-action="offer-filter#uncheckAllStatuses">Aucun</button>
                                </div>
                            </div>
                            <div class="filter-dropdown-grid">
                                <label class="filter-dropdown-item">
                                    <input type="checkbox" value="UNPROCESSED" data-offer-filter-target="statusCheckbox" data-action="change->offer-filter#updateFilters" checked>
                                    <span>📋 À traiter</span>
                                </label>
                                <label class="filter-dropdown-item">
                                    <input type="checkbox" value="INTERESTED" data-offer-filter-target="statusCheckbox" data-action="change->offer-filter#updateFilters" checked>
                                    <span>⭐ M’intéresse</span>
                                </label>
                                <label class="filter-dropdown-item">
                                    <input type="checkbox" value="APPLIED" data-offer-filter-target="statusCheckbox" data-action="change->offer-filter#updateFilters" checked>
                                    <span>📨 Candidaté</span>
                                </label>
                                <label class="filter-dropdown-item">
                                    <input type="checkbox" value="WAITING" data-offer-filter-target="statusCheckbox" data-action="change->offer-filter#updateFilters" checked>
                                    <span>⏳ En attente</span>
                                </label>
                                <label class="filter-dropdown-item">
                                    <input type="checkbox" value="INTERVIEW" data-offer-filter-target="statusCheckbox" data-action="change->offer-filter#updateFilters" checked>
                                    <span>🗣️ Entretien</span>
                                </label>
                                <label class="filter-dropdown-item">
                                    <input type="checkbox" value="NOT_INTERESTED" data-offer-filter-target="statusCheckbox" data-action="change->offer-filter#updateFilters" checked>
                                    <span>🚫 Écarté</span>
                                </label>
                                <label class="filter-dropdown-item">
                                    <input type="checkbox" value="REJECTED" data-offer-filter-target="statusCheckbox" data-action="change->offer-filter#updateFilters" checked>
                                    <span>❌ Refusé</span>
                                </label>
                                <label class="filter-dropdown-item">
                                    <input type="checkbox" value="ACCEPTED" data-offer-filter-target="statusCheckbox" data-action="change->offer-filter#updateFilters" checked>
                                    <span>🎉 Accepté</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </details>
            </div>
        </div>
        <p class="source-filter-empty" data-offer-filter-target="empty" hidden>Aucune offre correspondant à vos critères de filtrage.</p>
        <section class="offer-list">
            {% for match in matches %}
                {% set offer = match.jobOffer %}
                {% set provider = offer.source.provider.value %}
                {% set isEsn = offer.isEsn %}
                {% set isNotInterested = match.applicationStatus.value == 'NOT_INTERESTED' %}
                {% set isAnalyzing = match.semanticAnalysisStatus.value in ['QUEUED', 'RUNNING'] %}
                <article class="offer-card {{ isNotInterested ? 'offer-card-not-interested' : '' }}" id="job-match-{{ match.id }}" data-offer-filter-target="card" data-offer-filter-value="{{ provider }}" data-offer-filter-provider="{{ provider }}" data-offer-filter-esn="{{ isEsn ? '1' : '0' }}" data-offer-filter-status="{{ match.applicationStatus.value }}" data-offer-filter-score="{{ match.semanticScore is not null ? match.semanticScore : '' }}" data-offer-filter-analyzing="{{ isAnalyzing ? '1' : '0' }}">
                    <div class="offer-score">
                        {% if match.semanticAnalysisStatus.value == 'COMPLETED' %}
                            <span class="score score-{{ match.semanticScore >= 75 ? 'good' : (match.semanticScore >= 50 ? 'medium' : 'low') }}"><strong>{{ match.semanticScore }}</strong><small>%</small></span>
                        {% elseif match.semanticAnalysisStatus.value in ['QUEUED', 'RUNNING'] %}
                            <span class="score score-pending"><span class="spinner" aria-hidden="true"></span><small>Analyse</small></span>
                        {% else %}
                            <span class="score score-pending"><strong>—</strong><small>À analyser</small></span>
                        {% endif %}
                    </div>
                    <div class="offer-card-content">
                        <div class="offer-card-heading">
                            <div>
                                <p class="offer-company">{{ offer.company ?? 'Entreprise non renseignée' }}</p>
                                <h2 class="offer-title">
                                    <a class="offer-title-link" href="{{ path('app_job_offer_show', {id: match.id}) }}">{{ offer.title }}</a>
                                </h2>
                            </div>
                            <div class="offer-card-actions" data-controller="quick-status" data-quick-status-match-id-value="{{ match.id }}" data-quick-status-token-value="{{ csrf_token('quick-status-' ~ match.id) }}" data-quick-status-url-value="{{ path('app_job_offer_quick_status', {id: match.id}) }}">
                                <button type="button"
                                        class="action-btn action-btn-favorite {{ match.applicationStatus.value == 'INTERESTED' ? 'is-active' : '' }}"
                                        data-action="quick-status#toggleFavorite"
                                        data-quick-status-target="favoriteBtn"
                                        title="{{ match.applicationStatus.value == 'INTERESTED' ? 'Retirer des favoris (marquer À traiter)' : 'Mettre en favoris (M’intéresse)' }}"
                                        aria-label="Mettre en favoris l’offre {{ offer.title }}">
                                    <span class="btn-icon">⭐</span>
                                </button>
                                <button type="button"
                                        class="action-btn action-btn-discard {{ match.applicationStatus.value == 'NOT_INTERESTED' ? 'is-active' : '' }}"
                                        data-action="quick-status#toggleDiscard"
                                        data-quick-status-target="discardBtn"
                                        title="{{ match.applicationStatus.value == 'NOT_INTERESTED' ? 'Annuler l’écartement (marquer À traiter)' : 'Écarter l’offre (Ne m’intéresse pas)' }}"
                                        aria-label="Écarter l’offre {{ offer.title }}">
                                    <span class="btn-icon">🚫</span>
                                </button>
                                <a href="{{ path('app_job_offer_show', {id: match.id}) }}" class="arrow-link" aria-label="Voir le détail de l’offre {{ offer.title }}">→</a>
                            </div>
                        </div>
                        <div class="offer-meta">
                            <span class="badge badge-info">{{ providerLabels[provider] ?? provider }}</span>
                            {% if isEsn %}<span class="badge badge-warning badge-esn" title="Entreprise de services du numérique / Cabinet de conseil ou recrutement">ESN</span>{% endif %}
                            <span class="badge {{ match.applicationStatus.badgeClass }} offer-status-badge" data-status-badge-for="{{ match.id }}" {{ match.applicationStatus.value == 'UNPROCESSED' ? 'hidden' : '' }}>{{ match.applicationStatus.icon }} {{ match.applicationStatus.label }}</span>
                            {% if offer.status.value == 'EXPIRED' %}<span class="badge badge-neutral">Annonce expirée</span>{% endif %}
                            {% if match.statusReason %}
                                <span title="{{ match.statusReason }}">💬 {{ match.statusReason|slice(0, 35) }}{{ match.statusReason|length > 35 ? '…' : '' }}</span>
                            {% endif %}
                            {% if offer.location %}<span>{{ offer.location }}</span>{% endif %}
                            {% if offer.contractType %}<span>{{ offer.contractType }}</span>{% endif %}
                            {% if offer.minimumSalary or offer.maximumSalary %}
                                <span>{{ offer.minimumSalary ? offer.minimumSalary|number_format(0, ',', ' ') : '?' }} – {{ offer.maximumSalary ? offer.maximumSalary|number_format(0, ',', ' ') : '?' }} €</span>
                            {% endif %}
                            {% if (currentView ?? 'ranked') == 'latest' %}
                                <span>Trouvée le {{ offer.firstSeenAt|date('d/m/Y') }}</span>
                                {% if offer.publishedAt %}<span>Publiée le {{ offer.publishedAt|date('d/m/Y') }}</span>{% endif %}
                            {% else %}
                                <span>{{ match.semanticAnalyzedAt ? 'Analysée le ' ~ match.semanticAnalyzedAt|date('d/m/Y') : 'Analyse en cours' }}</span>
                            {% endif %}
                        </div>
                        {% set jobSummary = match.jobSummary %}
                        {% set capacities = match.requiredCapacities %}
                        {% set expectations = match.keyExpectations %}
                        {% if jobSummary or capacities is not empty or expectations is not empty %}
                            <div class="offer-snippet">
                                {% if jobSummary %}
                                    <p class="offer-snippet-text">{{ jobSummary }}</p>
                                {% elseif expectations is not empty %}
                                    <p class="offer-snippet-text">{{ expectations|first }}</p>
                                {% endif %}
                                {% if capacities is not empty %}
                                    <div class="offer-snippet-badges">
                                        {% for cap in capacities|slice(0, 4) %}
                                            <span class="offer-capacity-pill">{{ cap }}</span>
                                        {% endfor %}
                                        {% if capacities|length > 4 %}
                                            <span class="offer-capacity-more">+{{ capacities|length - 4 }}</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        {% elseif offer.description %}
                            <div class="offer-snippet">
                                <p class="offer-snippet-text">{{ offer.description|striptags|slice(0, 150) }}{{ offer.description|striptags|length > 150 ? '…' : '' }}</p>
                            </div>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </section>
    {% endif %}
    </div>
{% endblock %}
