{% extends 'base.html.twig' %}

{% block title %}Offres importées · Job Matcher{% endblock %}

{% block body %}
    <div class="page-heading">
        <p class="eyebrow">Collecte</p>
        <h1>Offres importées</h1>
        <p>{{ matches|length }} offre(s) classée(s) selon leur compatibilité avec votre CV.</p>
    </div>

    <section class="card">
        {% if matches is empty %}
            <p>Aucune offre importée. <a href="{{ path('app_cv_upload') }}">Déposez un CV</a> pour générer une recherche HelloWork.</p>
        {% else %}
            <div class="table-wrapper">
                <table>
                    <thead><tr><th>Score</th><th>Titre</th><th>Entreprise</th><th>Localisation</th><th>Contrat</th><th>Salaire</th><th>Statut</th><th>Analyse</th></tr></thead>
                    <tbody>
                    {% for match in matches %}
                        {% set offer = match.jobOffer %}
                        <tr>
                            <td>
                                {% if match.semanticAnalysisStatus.value == 'COMPLETED' %}
                                    <span class="score score-{{ match.semanticScore >= 75 ? 'good' : (match.semanticScore >= 50 ? 'medium' : 'low') }}">{{ match.semanticScore }} %</span>
                                {% else %}
                                    <span class="badge">À analyser</span>
                                {% endif %}
                            </td>
                            <td><a href="{{ path('app_job_offer_show', {id: match.id}) }}">{{ offer.title }}</a></td>
                            <td>{{ offer.company ?? 'Non renseignée' }}</td>
                            <td>{{ offer.location ?? 'Non renseignée' }}</td>
                            <td>{{ offer.contractType ?? 'Non renseigné' }}</td>
                            <td>
                                {% if offer.minimumSalary or offer.maximumSalary %}
                                    {{ offer.minimumSalary ? offer.minimumSalary|number_format(0, ',', ' ') : '?' }}
                                    – {{ offer.maximumSalary ? offer.maximumSalary|number_format(0, ',', ' ') : '?' }} €
                                {% else %}Non renseigné{% endif %}
                            </td>
                            <td><span class="badge">{{ offer.status.value }}</span></td>
                            <td>{{ match.semanticAnalyzedAt ? match.semanticAnalyzedAt|date('d/m/Y H:i') : 'Non analysée' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
