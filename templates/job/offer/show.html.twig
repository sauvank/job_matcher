{% extends 'base.html.twig' %}

{% block title %}{{ match.jobOffer.title }} · Job Matcher{% endblock %}

{% block body %}
    {% set offer = match.jobOffer %}
    {% set isAnalyzing = match.semanticAnalysisStatus.value in ['QUEUED', 'RUNNING'] %}
    <turbo-frame id="job-offer-show-frame" target="_top" {% if isAnalyzing %}data-controller="poll" data-poll-interval-value="3000" data-poll-url-value="{{ path('app_job_offer_show', {id: match.id}) }}"{% endif %}>
    {% set providerLabels = {
        'FAKE': 'Démonstration',
        'HELLOWORK': 'HelloWork',
        'INDEED': 'Indeed',
        'APEC': 'Apec',
        'FRANCE_TRAVAIL': 'France Travail',
        'WELCOME_TO_THE_JUNGLE': 'Welcome to the Jungle',
        'FREE_WORK': 'Free-Work'
    } %}
    {% set provider = offer.source.provider.value %}

    <a class="back-link" href="{{ path('app_job_offers') }}">← Retour aux offres</a>
    <section class="offer-hero card">
        <div class="offer-hero-main">
            <p class="eyebrow">{{ offer.company ?? 'Entreprise non renseignée' }}</p>
            <h1>{{ offer.title }}</h1>
            <div class="offer-meta">
                <span class="badge badge-info">{{ providerLabels[provider] ?? provider }}</span>
                {% if offer.isEsn %}<span class="badge badge-warning badge-esn" title="Entreprise de services du numérique / Cabinet de conseil ou recrutement">ESN</span>{% endif %}
                {% if offer.status.value == 'EXPIRED' %}<span class="badge badge-neutral">Annonce expirée</span>{% endif %}
                {% if match.applicationStatus.value != 'UNPROCESSED' %}
                    <span class="badge {{ match.applicationStatus.badgeClass }} offer-status-badge">{{ match.applicationStatus.icon }} {{ match.applicationStatus.label }}</span>
                {% endif %}
                {% if offer.location %}<span>{{ offer.location }}</span>{% endif %}
                {% if offer.contractType %}<span>{{ offer.contractType }}</span>{% endif %}
                {% if offer.yearsOfExperience is not null %}<span>{{ offer.yearsOfExperience }} ans d’expérience</span>{% endif %}
                <span>Trouvée le {{ offer.firstSeenAt|date('d/m/Y') }}</span>
                {% if offer.publishedAt %}<span>Publiée le {{ offer.publishedAt|date('d/m/Y') }}</span>{% endif %}
            </div>
            <div class="button-row">
                <a class="button" href="{{ offer.url }}" target="_blank" rel="noopener noreferrer">Voir l’annonce originale ↗</a>
                {% if match.applicationStatus.value != 'NOT_INTERESTED' %}
                    <form method="post" action="{{ path('app_job_offer_quick_status', {id: match.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('quick-status-' ~ match.id) }}">
                        <input type="hidden" name="status" value="NOT_INTERESTED">
                        <button type="submit" class="button secondary" title="Écarter cette offre et retourner à la liste">🚫 Ne m’intéresse pas</button>
                    </form>
                {% endif %}
                {% if match.semanticAnalysisStatus.value not in ['QUEUED', 'RUNNING'] or (match.semanticAnalysisStartedAt and (date().timestamp - match.semanticAnalysisStartedAt.timestamp) > 300) or match.semanticAnalysisStartedAt is null %}
                    <form method="post" action="{{ path('app_job_offer_analyze', {id: match.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('analyze-job-' ~ match.id) }}">
                        <button type="submit" class="button secondary">Relancer l’analyse</button>
                    </form>
                {% endif %}
            </div>
        </div>
        <div class="hero-score-wrap">
            {% if match.semanticAnalysisStatus.value == 'COMPLETED' %}
                <span class="hero-score score-{{ match.semanticScore >= 75 ? 'good' : (match.semanticScore >= 50 ? 'medium' : 'low') }}"><strong>{{ match.semanticScore }}</strong><small>%</small></span>
                <span>{{ match.semanticScore >= 75 ? 'Bon match' : (match.semanticScore >= 50 ? 'À vérifier' : 'Match faible') }}</span>
            {% else %}
                <span class="hero-score score-pending"><span class="spinner" aria-hidden="true"></span></span>
                <span>Analyse en cours</span>
            {% endif %}
        </div>
    </section>

    <div class="offer-detail-layout">
        <div class="offer-detail-main">
            {% if semanticAnalysis and (semanticAnalysis.jobSummary or semanticAnalysis.keyExpectations is not empty or semanticAnalysis.requiredCapacities is not empty) %}
                <section class="card job-overview-card" id="apercu-poste">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">Aperçu express</p>
                            <h2>Le poste en un coup d’œil</h2>
                        </div>
                    </div>

                    {% if semanticAnalysis.jobSummary %}
                        <div class="job-overview-summary">
                            <p class="job-overview-lead">{{ semanticAnalysis.jobSummary }}</p>
                        </div>
                    {% endif %}

                    <div class="job-overview-grid">
                        {% if semanticAnalysis.keyExpectations is not empty %}
                            <div class="job-overview-box">
                                <h3>🎯 Attentes & Missions clés</h3>
                                <ul class="job-overview-list">
                                    {% for expectation in semanticAnalysis.keyExpectations %}
                                        <li>{{ expectation }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        {% if semanticAnalysis.requiredCapacities is not empty %}
                            <div class="job-overview-box">
                                <h3>💡 Capacités & Compétences attendues</h3>
                                <div class="job-overview-capsules">
                                    {% for capacity in semanticAnalysis.requiredCapacities %}
                                        <span class="job-capacity-badge">{{ capacity }}</span>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </section>
            {% endif %}

            {% if assistantResult %}
                <section class="card assistant-card" id="assistant-postulation">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">Aide à la candidature</p>
                            <h2>✍️ Assistant de postulation & Entretien</h2>
                        </div>
                    </div>
                    <p class="help-text">Documents prêts à l'emploi rédigés sur-mesure à partir de vos points forts et des exigences de l'offre.</p>

                    <div class="assistant-tabs" role="tablist">
                        <details class="assistant-disclosure" open>
                            <summary>
                                <span class="assistant-disclosure-title">📨 Message d’accroche (LinkedIn / Email court)</span>
                                <span class="assistant-disclosure-hint">Pour premier contact</span>
                            </summary>
                            <div class="assistant-content" data-controller="clipboard">
                                <div class="assistant-copy-bar">
                                    <span class="assistant-badge">Format court</span>
                                    <button type="button" class="button button-compact secondary" data-clipboard-target="button" data-action="click->clipboard#copy">📋 Copier le message</button>
                                </div>
                                <textarea readonly class="assistant-textarea" data-clipboard-target="source" rows="7">{{ assistantResult.pitch }}</textarea>
                            </div>
                        </details>

                        <details class="assistant-disclosure">
                            <summary>
                                <span class="assistant-disclosure-title">📄 Lettre de motivation sur-mesure</span>
                                <span class="assistant-disclosure-hint">Pour dossier formel</span>
                            </summary>
                            <div class="assistant-content" data-controller="clipboard">
                                <div class="assistant-copy-bar">
                                    <span class="assistant-badge">Format complet</span>
                                    <button type="button" class="button button-compact secondary" data-clipboard-target="button" data-action="click->clipboard#copy">📋 Copier la lettre</button>
                                </div>
                                <textarea readonly class="assistant-textarea" data-clipboard-target="source" rows="14">{{ assistantResult.coverLetter }}</textarea>
                            </div>
                        </details>

                        <details class="assistant-disclosure">
                            <summary>
                                <span class="assistant-disclosure-title">🗣️ Préparateur d’entretien (Questions & Réponses)</span>
                                <span class="assistant-disclosure-hint">{{ assistantResult.interviewQuestions|length }} questions clés</span>
                            </summary>
                            <div class="assistant-content">
                                <div class="interview-questions-list">
                                    {% for item in assistantResult.interviewQuestions %}
                                        <article class="interview-question-card">
                                            <h4>❓ {{ item.question }}</h4>
                                            <p class="interview-context"><span class="field-label">Objectif recruteur :</span> {{ item.context }}</p>
                                            <div class="interview-advice">
                                                <span class="field-label">Conseil de réponse :</span>
                                                <p>{{ item.suggestedAnswer }}</p>
                                            </div>
                                        </article>
                                    {% endfor %}
                                </div>
                            </div>
                        </details>

                        <details class="assistant-disclosure">
                            <summary>
                                <span class="assistant-disclosure-title">⏳ Message de relance (J+7)</span>
                                <span class="assistant-disclosure-hint">Sans réponse</span>
                            </summary>
                            <div class="assistant-content" data-controller="clipboard">
                                <div class="assistant-copy-bar">
                                    <span class="assistant-badge">Relance polie</span>
                                    <button type="button" class="button button-compact secondary" data-clipboard-target="button" data-action="click->clipboard#copy">📋 Copier la relance</button>
                                </div>
                                <textarea readonly class="assistant-textarea" data-clipboard-target="source" rows="7">{{ assistantResult.followUpMessage }}</textarea>
                            </div>
                        </details>
                    </div>
                </section>
            {% endif %}

            <section class="card analysis-card" id="rapport-detaille">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Rapport détaillé</p>
                        <h2>Pourquoi ce score ?</h2>
                    </div>
                    {% if match.semanticAnalyzedAt %}<span class="help-text">Mis à jour le {{ match.semanticAnalyzedAt|date('d/m/Y à H:i') }}</span>{% endif %}
                </div>

                {% if match.semanticAnalysisStatus.value in ['QUEUED', 'RUNNING'] %}
                    <div class="progress-block">
                        <span>{{ match.semanticAnalysisStatus.value == 'QUEUED' ? 'Analyse en attente…' : 'Analyse du texte complet et du CV…' }}</span>
                        <progress max="100">Analyse en cours</progress>
                    </div>
                {% elseif match.semanticAnalysisStatus.value == 'FAILED' %}
                    <p class="text-error">{{ match.semanticError|trans }}</p>
                {% elseif semanticAnalysis %}
                    <div class="semantic-summary"><p>{{ semanticAnalysis.summary }}</p></div>

                    <div class="requirement-list">
                        {% for requirement in semanticAnalysis.requirements %}
                            <article class="requirement-card">
                                <div class="requirement-heading">
                                    <div><h3>{{ requirement.label }}</h3><div class="tag-row"><span class="badge">{{ requirement.category.value }}</span><span class="badge badge-neutral">{{ requirement.importance.value }}</span></div></div>
                                    <span class="badge verdict-{{ requirement.assessment.value|lower }}">{{ requirement.assessment.value }}</span>
                                </div>
                                <div class="evidence-grid">
                                    <div><span class="field-label">Dans l’annonce</span><blockquote>{{ requirement.offerEvidence }}</blockquote></div>
                                    <div><span class="field-label">Dans votre CV</span><blockquote>{{ requirement.cvEvidence ?? 'Aucune preuve explicite trouvée' }}</blockquote></div>
                                </div>
                                <p class="requirement-explanation">{{ requirement.explanation }}</p>
                            </article>
                        {% endfor %}
                    </div>

                    <div class="explanation-grid">
                        <div class="insight insight-positive"><h3>Forces</h3><ul>{% for item in semanticAnalysis.strengths %}<li>{{ item }}</li>{% else %}<li>Aucune force certaine.</li>{% endfor %}</ul></div>
                        <div class="insight insight-warning"><h3>Points de vigilance</h3><ul>{% for item in semanticAnalysis.concerns %}<li>{{ item }}</li>{% else %}<li>Aucun point de vigilance certain.</li>{% endfor %}</ul></div>
                        <div class="insight insight-info"><h3>Questions à poser</h3><ul>{% for item in semanticAnalysis.questions %}<li>{{ item }}</li>{% else %}<li>Aucune question supplémentaire.</li>{% endfor %}</ul></div>
                    </div>
                {% else %}
                    <p>L’analyse complète lit toutes les missions, exigences, responsabilités, qualités attendues et conditions de travail, puis les compare au texte du CV avec des preuves.</p>
                {% endif %}
            </section>
        </div>

        <aside class="offer-detail-sidebar">
            <section class="card status-tracking-card" id="suivi-candidature">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Suivi personnel</p>
                        <h2>Statut & Candidature</h2>
                    </div>
                    {% if match.statusUpdatedAt %}
                        <span class="help-text">Mis à jour le {{ match.statusUpdatedAt|date('d/m/Y à H:i') }}</span>
                    {% endif %}
                </div>

                <div class="status-tracking-layout">
                    {% if match.applicationStatus.value == 'APPLIED' and match.statusUpdatedAt and (date().timestamp - match.statusUpdatedAt.timestamp) >= (7 * 86400) %}
                        <div class="followup-alert-banner">
                            <span class="followup-alert-icon" aria-hidden="true">⏳</span>
                            <div>
                                <strong>Relance recommandée</strong>
                                <p>Candidature transmise il y a plus de 7 jours sans retour. Vous pouvez utiliser le message de relance rédigé par l'assistant.</p>
                            </div>
                        </div>
                    {% endif %}

                    <div class="status-current-display">
                        <div class="status-current-badge-wrap">
                            <span class="status-current-label">Statut actuel</span>
                            <span class="badge {{ match.applicationStatus.badgeClass }} status-badge-lg">
                                {{ match.applicationStatus.icon }} {{ match.applicationStatus.label }}
                            </span>
                        </div>
                        {% if match.statusReason %}
                            <div class="status-current-reason">
                                <span class="field-label">Note / Raison</span>
                                <blockquote>{{ match.statusReason }}</blockquote>
                            </div>
                        {% endif %}
                    </div>

                    {{ form_start(statusForm, {'attr': {'class': 'status-edit-form'}}) }}
                        <div class="form-row">
                            {{ form_label(statusForm.status) }}
                            {{ form_widget(statusForm.status, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(statusForm.status) }}
                        </div>
                        <div class="form-row">
                            {{ form_label(statusForm.reason) }}
                            {{ form_widget(statusForm.reason, {'attr': {'class': 'form-textarea', 'rows': '3', 'placeholder': 'Ajouter une note ou la raison...'}}) }}
                            {{ form_errors(statusForm.reason) }}
                        </div>
                        <div class="button-row">
                            <button type="submit" class="button button-full">Enregistrer le statut</button>
                        </div>
                    {{ form_end(statusForm) }}
                </div>
            </section>
        </aside>
    </div>
    </turbo-frame>
{% endblock %}
