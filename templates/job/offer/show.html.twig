{% extends 'base.html.twig' %}

{% block title %}{{ match.jobOffer.title }} · Job Matcher{% endblock %}

{% block body %}
    {% set offer = match.jobOffer %}
    {% set explanation = match.explanation %}

    <div class="page-heading">
        <p class="eyebrow">Compatibilité</p>
        <h1>{{ match.globalScore }} % — {{ match.globalScore >= 75 ? 'Bon match' : (match.globalScore >= 50 ? 'Match à vérifier' : 'Match faible') }}</h1>
        <p>{{ offer.title }}{% if offer.company %} chez {{ offer.company }}{% endif %}</p>
        <a class="button" href="{{ offer.url }}" target="_blank" rel="noopener noreferrer">Voir l’annonce originale</a>
        <a class="button secondary" href="{{ path('app_job_offers') }}">Retour aux offres</a>
    </div>

    <section class="card">
        <h2>Détail du score</h2>
        <div class="score-grid">
            <div><span>Compétences</span><strong>{{ match.stackScore }} %</strong></div>
            <div><span>Expérience</span><strong>{{ match.experienceScore }} %</strong></div>
            <div><span>Salaire</span><strong>{{ match.salaryScore }} %</strong></div>
            <div><span>Localisation</span><strong>{{ match.locationScore }} %</strong></div>
            <div><span>Contrat</span><strong>{{ match.contractScore }} %</strong></div>
            <div><span>Télétravail</span><strong>{{ match.remoteScore }} %</strong></div>
            <div><span>Orientation backend</span><strong>{{ match.backendScore }} %</strong></div>
        </div>
        <p class="help-text">Ce score est calculé avec des règles déterministes. L’analyse sémantique par IA sera ajoutée séparément.</p>
    </section>

    <div class="explanation-grid">
        <section class="card">
            <h2>Points forts</h2>
            {% if explanation.strengths is empty %}
                <p>Aucun point fort confirmé avec les données disponibles.</p>
            {% else %}
                <ul>{% for reason in explanation.strengths %}<li>{{ reason.key|trans(reason.parameters) }}</li>{% endfor %}</ul>
            {% endif %}
        </section>

        <section class="card">
            <h2>Points faibles</h2>
            {% if explanation.gaps is empty %}
                <p>Aucun écart détecté.</p>
            {% else %}
                <ul>{% for reason in explanation.gaps %}<li>{{ reason.key|trans(reason.parameters) }}</li>{% endfor %}</ul>
            {% endif %}
        </section>

        <section class="card">
            <h2>Critères bloquants</h2>
            {% if explanation.blockers is empty %}
                <p>Aucun critère bloquant détecté.</p>
            {% else %}
                <ul>{% for reason in explanation.blockers %}<li>{{ reason.key|trans(reason.parameters) }}</li>{% endfor %}</ul>
            {% endif %}
        </section>

        <section class="card">
            <h2>Informations à vérifier</h2>
            {% if explanation.unknowns is empty %}
                <p>Aucune information manquante.</p>
            {% else %}
                <ul>{% for reason in explanation.unknowns %}<li>{{ reason.key|trans(reason.parameters) }}</li>{% endfor %}</ul>
            {% endif %}
        </section>
    </div>
{% endblock %}
