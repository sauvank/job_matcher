{% extends 'base.html.twig' %}

{% block title %}Sources d’offres · Job Matcher{% endblock %}

{% block body %}
    <div class="page-heading">
        <p class="eyebrow">Collecte</p>
        <h1>Sources d’offres</h1>
        <p>HelloWork, Apec, France Travail, Welcome to the Jungle et Free-Work sont synchronisés automatiquement. Indeed peut refuser les connexions du serveur ; son état indique alors clairement le blocage.</p>
    </div>

    <section class="card form-card">
        {% if profileLocation %}
            {% if suggestedSearches is defined and suggestedSearches is not empty %}
                {% set configuredLabels = [] %}
                {% for source in sources %}
                    {% if source.searchLabel not in configuredLabels %}
                        {% set configuredLabels = configuredLabels|merge([source.searchLabel]) %}
                    {% endif %}
                {% endfor %}

                <div class="smart-searches-box" data-controller="smart-search-selector">
                    <div class="smart-searches-header">
                        <h2>💡 Suggestions de recherches intelligentes</h2>
                        <p>Sélectionnez un ou plusieurs intitulés ciblés générés à partir de votre CV pour lancer la recherche sur tous les job boards en 1 clic :</p>
                    </div>

                    <form method="post" action="{{ path('app_job_sources_add_multiple') }}" class="smart-searches-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('add-multiple-sources') }}">
                        <div class="smart-searches-list">
                            {% for suggestion in suggestedSearches %}
                                {% set isAlreadyConfigured = false %}
                                {% for label in configuredLabels %}
                                    {% if label|lower == suggestion|lower %}
                                        {% set isAlreadyConfigured = true %}
                                    {% endif %}
                                {% endfor %}

                                {% if isAlreadyConfigured %}
                                    <span class="smart-search-chip active" title="Cette recherche est déjà configurée">
                                        ✓ {{ suggestion }}
                                    </span>
                                {% else %}
                                    <label class="smart-search-chip selectable" title="Cocher pour sélectionner « {{ suggestion }} »">
                                        <input type="checkbox" name="titles[]" value="{{ suggestion }}" data-smart-search-selector-target="checkbox" data-action="change->smart-search-selector#updateCount">
                                        <span>+ {{ suggestion }}</span>
                                    </label>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <div class="smart-searches-actions">
                            <button type="button" class="button button-compact secondary" data-action="smart-search-selector#toggleAll" data-smart-search-selector-target="toggleBtn">
                                Tout sélectionner
                            </button>
                            <button type="submit" class="button button-compact" data-smart-search-selector-target="submitBtn">
                                🚀 Ajouter et rechercher les intitulés sélectionnés
                            </button>
                        </div>
                    </form>
                </div>

                <div class="custom-search-divider">
                    <span>ou saisir un autre intitulé personnalisé</span>
                </div>
            {% endif %}

            <div class="custom-search-wrap">
                <h2>Ajouter une recherche manuelle</h2>
                <p>Chaque intitulé lance une recherche séparée autour de {{ profileLocation }}.</p>
                {{ form_start(searchForm) }}
                    {{ form_row(searchForm.title) }}
                    {{ form_row(searchForm.add) }}
                {{ form_end(searchForm) }}
            </div>
        {% else %}
            <h2>Ajouter une recherche</h2>
            <p>Validez d’abord la localisation de votre profil depuis un CV.</p>
        {% endif %}
    </section>

    <turbo-frame id="job-sources-list" {% if hasActiveSync %}data-controller="poll" data-poll-interval-value="2000" data-poll-url-value="{{ path('app_job_sources') }}"{% endif %}>
        <section class="card">
            <div class="section-heading">
                <h2>Sources configurées</h2>
                <a href="{{ path('app_job_offers') }}" data-turbo-frame="_top">Voir les offres</a>
            </div>

            {% if sources is empty %}
                <p>Aucune recherche configurée. Déposez un CV, puis validez son intitulé de poste et sa localisation.</p>
            {% else %}
                {% set searchLabels = [] %}
                {% for source in sources %}
                    {% if source.searchLabel not in searchLabels %}
                        {% set searchLabels = searchLabels|merge([source.searchLabel]) %}
                    {% endif %}
                {% endfor %}
                <div data-controller="source-filter">
                    <div class="source-filter-tabs" role="tablist" aria-label="Filtrer les sources par recherche">
                        <button type="button" class="source-filter-tab active" role="tab" aria-selected="true" data-source-filter-target="tab" data-source-filter-value="" data-action="source-filter#select">Toutes</button>
                        {% for searchLabel in searchLabels %}
                            <button type="button" class="source-filter-tab" role="tab" aria-selected="false" data-source-filter-target="tab" data-source-filter-value="{{ searchLabel }}" data-action="source-filter#select">{{ searchLabel }}</button>
                        {% endfor %}
                    </div>
                    <p class="source-filter-empty" data-source-filter-target="empty" hidden>Aucune source pour cette recherche.</p>
                    <div class="table-wrapper">
                    <table>
                    <thead><tr><th>Nom</th><th>Fournisseur</th><th>Dernier succès</th><th>État</th><th></th></tr></thead>
                    <tbody>
                    {% for source in sources %}
                        <tr id="job-source-{{ source.id }}" data-source-filter-target="row" data-source-filter-value="{{ source.searchLabel }}">
                            <td><a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.name }}</a></td>
                            <td><span class="badge">{{ source.provider.value }}</span></td>
                            <td>{{ source.lastSuccessAt ? source.lastSuccessAt|date('d/m/Y H:i') : 'Jamais' }}</td>
                            <td>
                                {% if source.syncStatus.value == 'QUEUED' %}
                                    <div class="progress-block compact">
                                        <span class="status-indicator">
                                            <span class="spinner-sm"></span>
                                            <span>En file d’attente…</span>
                                        </span>
                                        <progress max="100">En attente du worker</progress>
                                    </div>
                                {% elseif source.syncStatus.value == 'RUNNING' %}
                                    <div class="progress-block compact">
                                        <span class="status-indicator">
                                            <span class="spinner-sm"></span>
                                            <span><strong>{{ source.processedOfferCount }}</strong> offre(s) traitée(s)</span>
                                        </span>
                                        <progress max="10" value="{{ source.processedOfferCount }}">{{ source.processedOfferCount }} / 10</progress>
                                    </div>
                                {% elseif source.syncStatus.value == 'SUCCEEDED' %}
                                    <div class="status-badge-wrap">
                                        <span class="badge badge-success">
                                            ✓ {{ source.processedOfferCount }} offre(s) importée(s)
                                        </span>
                                    </div>
                                {% elseif source.lastError %}
                                    <div class="status-badge-wrap">
                                        <span class="badge badge-danger" title="{{ source.lastError }}">
                                            ✕ {{ source.lastError|trans }}
                                        </span>
                                    </div>
                                {% else %}
                                    <span class="badge badge-info">Prête</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="table-actions">
                                    <form method="post" action="{{ path('app_job_source_sync', {id: source.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('sync-source-' ~ source.id) }}">
                                        <button type="submit" class="button secondary">Synchroniser</button>
                                    </form>
                                    <form method="post" action="{{ path('app_job_source_delete', {id: source.id}) }}" data-turbo-confirm="Supprimer cette recherche et toutes ses offres importées ?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-source-' ~ source.id) }}">
                                        <button type="submit" class="button danger" {{ source.syncPending ? 'disabled' : '' }}>Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    </table>
                    </div>
                </div>
            {% endif %}
        </section>
        {% if hasActiveSync %}
            <script>
                window.setTimeout(() => {
                    const frame = document.getElementById('job-sources-list');
                    if (frame?.src) {
                        frame.reload();
                    } else if (frame) {
                        frame.src = '{{ path('app_job_sources') }}';
                    }
                }, 2000);
            </script>
        {% endif %}
    </turbo-frame>
{% endblock %}
