{% extends 'base.html.twig' %}

{% block title %}Sources d’offres · Job Matcher{% endblock %}

{% block body %}
    <div class="page-heading">
        <p class="eyebrow">Collecte</p>
        <h1>Sources d’offres</h1>
        <p>La recherche HelloWork est générée automatiquement à partir du titre et de la localisation validés depuis votre CV.</p>
    </div>

    <section class="card form-card">
        <h2>Ajouter une recherche</h2>
        {% if profileLocation %}
            <p>Chaque intitulé lance une recherche séparée autour de {{ profileLocation }}.</p>
            {{ form_start(searchForm) }}
                {{ form_row(searchForm.title) }}
                {{ form_row(searchForm.add) }}
            {{ form_end(searchForm) }}
        {% else %}
            <p>Validez d’abord la localisation de votre profil depuis un CV.</p>
        {% endif %}
    </section>

    <turbo-frame id="job-sources-list">
        <section class="card">
            <div class="section-heading">
                <h2>Sources configurées</h2>
                <a href="{{ path('app_job_offers') }}" data-turbo-frame="_top">Voir les offres</a>
            </div>

            {% if sources is empty %}
                <p>Aucune recherche configurée. Déposez un CV, puis validez son intitulé de poste et sa localisation.</p>
            {% else %}
                <div class="table-wrapper">
                    <table>
                    <thead><tr><th>Nom</th><th>Fournisseur</th><th>Dernier succès</th><th>État</th><th></th></tr></thead>
                    <tbody>
                    {% for source in sources %}
                        <tr id="job-source-{{ source.id }}">
                            <td><a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.name }}</a></td>
                            <td>{{ source.provider.value }}</td>
                            <td>{{ source.lastSuccessAt ? source.lastSuccessAt|date('d/m/Y H:i') : 'Jamais' }}</td>
                            <td>
                                {% if source.syncStatus.value == 'QUEUED' %}
                                    <div class="progress-block compact">
                                        <span>Mise en attente…</span>
                                        <progress max="100">Import en attente</progress>
                                    </div>
                                {% elseif source.syncStatus.value == 'RUNNING' %}
                                    <div class="progress-block compact">
                                        <span>{{ source.processedOfferCount }} offre(s) traitée(s)</span>
                                        <progress max="100">Import en cours</progress>
                                    </div>
                                {% elseif source.syncStatus.value == 'SUCCEEDED' %}
                                    <div class="progress-block compact">
                                        <span>{{ source.processedOfferCount }} offre(s) traitée(s)</span>
                                        <progress max="100" value="100">100 %</progress>
                                    </div>
                                {% elseif source.lastError %}
                                    <span class="text-error">{{ source.lastError|trans }}</span>
                                {% else %}
                                    Prête
                                {% endif %}
                            </td>
                            <td>
                                <div class="table-actions">
                                    <form method="post" action="{{ path('app_job_source_sync', {id: source.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('sync-source-' ~ source.id) }}">
                                        <button type="submit" class="button secondary">Synchroniser</button>
                                    </form>
                                    <form method="post" action="{{ path('app_job_source_delete', {id: source.id}) }}" data-turbo-confirm="Supprimer cette recherche et toutes ses offres importées ?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-source-' ~ source.id) }}">
                                        <button type="submit" class="button danger" {{ source.syncPending ? 'disabled' : '' }}>Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
        {% if hasActiveSync %}
            <script>
                window.setTimeout(() => {
                    const frame = document.getElementById('job-sources-list');
                    if (frame?.src) {
                        frame.reload();
                    } else if (frame) {
                        frame.src = '{{ path('app_job_sources') }}';
                    }
                }, 2000);
            </script>
        {% endif %}
    </turbo-frame>
{% endblock %}
