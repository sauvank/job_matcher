{% extends 'base.html.twig' %}

{% block title %}Sources d’offres · Job Matcher{% endblock %}

{% block body %}
    <div class="page-heading">
        <p class="eyebrow">Collecte</p>
        <h1>Sources d’offres</h1>
        <p>Ajoutez une recherche HelloWork. Les dix premières fiches seront importées en arrière-plan.</p>
    </div>

    <section class="card form-card">
        <h2>Ajouter une source</h2>
        {{ form_start(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.url) }}
            {{ form_row(form.save) }}
        {{ form_end(form) }}
    </section>

    <section class="card">
        <div class="section-heading">
            <h2>Sources configurées</h2>
            <a href="{{ path('app_job_offers') }}">Voir les offres</a>
        </div>

        {% if sources is empty %}
            <p>Aucune source configurée.</p>
        {% else %}
            <div class="table-wrapper">
                <table>
                    <thead><tr><th>Nom</th><th>Fournisseur</th><th>Dernier succès</th><th>État</th><th></th></tr></thead>
                    <tbody>
                    {% for source in sources %}
                        <tr>
                            <td><a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.name }}</a></td>
                            <td>{{ source.provider.value }}</td>
                            <td>{{ source.lastSuccessAt ? source.lastSuccessAt|date('d/m/Y H:i') : 'Jamais' }}</td>
                            <td>
                                {% if source.lastError %}<span class="text-error">{{ source.lastError|trans }}</span>{% else %}Prête{% endif %}
                            </td>
                            <td>
                                <form method="post" action="{{ path('app_job_source_sync', {id: source.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('sync-source-' ~ source.id) }}">
                                    <button type="submit" class="button secondary">Synchroniser</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
