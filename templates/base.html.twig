<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Job Matcher{% endblock %}</title>
        <link rel="stylesheet" href="/styles/app.css">
    </head>
    <body>
        <header class="site-header">
            <a class="brand" href="{{ path('app_home') }}">Job Matcher</a>
            <nav>
                <a href="{{ path('app_cv_upload') }}">Mon CV</a>
                <a href="{{ path('app_candidate_profile') }}">Mon profil</a>
            </nav>
        </header>
        <main class="container">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}">{{ message|trans }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
