<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Job Matcher{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('styles/app.scss') }}" data-turbo-track="reload">
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    </head>
    <body>
        {% if is_granted('IS_IMPERSONATOR') %}
            <aside class="impersonation-bar" role="alert" aria-label="Session d'usurpation active">
                <div class="impersonation-inner">
                    <span class="impersonation-text">
                        <span class="impersonation-icon" aria-hidden="true">⚠️</span>
                        Connecté en tant que <strong>{{ app.user.userIdentifier }}</strong> (Session usurpée)
                    </span>
                    <a class="button button-compact secondary impersonation-exit" href="{{ path('app_admin_users', {'_switch_user': '_exit'}) }}">
                        Quitter l'impersonation &rarr;
                    </a>
                </div>
            </aside>
        {% endif %}
        <header class="site-header">
            {% set currentRoute = app.request.attributes.get('_route') ?? '' %}
            <div class="header-inner">
                <a class="brand" href="{{ path('app_home') }}" aria-label="Job Matcher — Accueil">
                    <span class="brand-mark" aria-hidden="true">JM</span>
                    <span>Job Matcher</span>
                </a>
                {% if app.user %}
                    <nav aria-label="Navigation principale">
                        <a class="{{ currentRoute starts with 'app_cv' ? 'active' : '' }}" href="{{ path('app_cv_upload') }}">Mon CV</a>
                        <a class="{{ currentRoute == 'app_candidate_profile' ? 'active' : '' }}" href="{{ path('app_candidate_profile') }}">Mon profil</a>
                        <a class="{{ currentRoute == 'app_candidate_cv_optimization' ? 'active' : '' }}" href="{{ path('app_candidate_cv_optimization') }}">Optimiser mon CV</a>
                        <a class="{{ currentRoute starts with 'app_job_source' ? 'active' : '' }}" href="{{ path('app_job_sources') }}">Sources</a>
                        <a class="{{ currentRoute starts with 'app_job_offer' ? 'active' : '' }}" href="{{ path('app_job_offers') }}">Offres</a>
                        <a class="{{ currentRoute == 'app_applications_kanban' ? 'active' : '' }}" href="{{ path('app_applications_kanban') }}">Candidatures</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="{{ currentRoute starts with 'app_admin' ? 'active' : '' }}" href="{{ path('app_admin_dashboard') }}">Administration</a>
                        {% endif %}
                        <a class="{{ currentRoute starts with 'app_account_' ? 'active' : '' }}" href="{{ path('app_account_settings') }}">Paramètres</a>
                        <form method="post" action="{{ path('app_logout') }}" data-turbo="false">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button class="nav-logout" type="submit">Déconnexion</button>
                        </form>
                    </nav>
                {% else %}
                    <nav aria-label="Navigation principale">
                        <a class="{{ currentRoute == 'app_login' ? 'active' : '' }}" href="{{ path('app_login') }}">Connexion</a>
                    </nav>
                {% endif %}
            </div>
        </header>
        <main class="container main-content">
            <div id="flash-messages">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash flash-{{ type }}">{{ message|trans }}</div>
                    {% endfor %}
                {% endfor %}
            </div>
            {% block body %}{% endblock %}
        </main>
        <footer class="site-footer"><span>Job Matcher</span><span>Analyse locale et privée</span></footer>
    </body>
</html>
