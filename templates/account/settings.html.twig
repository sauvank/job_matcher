{% extends 'base.html.twig' %}

{% block title %}Paramètres du compte · Job Matcher{% endblock %}

{% block body %}
    <div class="page-heading">
        <p class="eyebrow">Mon compte</p>
        <h1>Paramètres du compte</h1>
    </div>

    <section class="section" id="alerts">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Notifications</p>
                <h2>Alertes email quotidiennes</h2>
            </div>
            {% if account.lastAlertEmailSentAt %}
                <span class="help-text">Dernier email envoyé le {{ account.lastAlertEmailSentAt|date('d/m/Y à H:i') }}</span>
            {% endif %}
        </div>
        <div class="card">
            <p>Recevez un email récapitulatif quotidien lorsque de nouvelles offres d’emploi correspondant à votre profil sont découvertes par Job Matcher.</p>

            {{ form_start(alertForm, {'attr': {'class': 'form-grid'}}) }}
                <div class="form-row">
                    <label class="checkbox-label">
                        {{ form_widget(alertForm.alertEmailEnabled) }}
                        <span>{{ form_label(alertForm.alertEmailEnabled) }}</span>
                    </label>
                    {{ form_errors(alertForm.alertEmailEnabled) }}
                </div>

                <div class="form-row">
                    {{ form_label(alertForm.alertScoreThreshold) }}
                    {{ form_widget(alertForm.alertScoreThreshold, {'attr': {'class': 'form-input', 'style': 'max-width: 140px;'}}) }}
                    {{ form_help(alertForm.alertScoreThreshold) }}
                    {{ form_errors(alertForm.alertScoreThreshold) }}
                </div>

                <div class="button-row">
                    <button type="submit" class="button">Enregistrer mes préférences d’alerte</button>
                </div>
            {{ form_end(alertForm) }}
        </div>
    </section>

    <section class="section" id="security" style="margin-top: 2rem;">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Sécurité</p>
                <h2>Connexion Google</h2>
            </div>
        </div>
        <div class="card">
            {% if googleConnected %}
                <p>Votre compte Google est associé à ce compte.</p>
            {% elseif googleEnabled %}
                <p>Associez Google uniquement après vous être connecté avec votre mot de passe. L'adresse Google devra correspondre à celle du compte.</p>
                <a class="button google-button" href="{{ path('app_google_link') }}"><span class="google-mark" aria-hidden="true">G</span> Associer mon compte Google</a>
            {% else %}
                <p>La connexion Google n'est pas configurée.</p>
            {% endif %}
        </div>
    </section>
{% endblock %}
