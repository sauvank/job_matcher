{% extends 'base.html.twig' %}

{% block title %}Mon profil · Job Matcher{% endblock %}

{% block body %}
    <div class="page-heading">
        <p class="eyebrow">Candidat</p>
        <h1>Mon profil</h1>
    </div>

    {% if profile %}
        {% if profile.activeCvDocument %}
            <div class="profile-active-cv-banner">
                <p class="profile-active-cv">CV actif : <a href="{{ path('app_cv_show', {id: profile.activeCvDocument.id}) }}">{{ profile.activeCvDocument.originalFilename }}</a></p>
                <a class="button button-compact secondary" href="{{ path('app_cv_file', {id: profile.activeCvDocument.id}) }}" target="_blank" rel="noopener noreferrer">📄 Voir le document original ↗</a>
            </div>
        {% endif %}
        {% set contractLabels = {
            'CDI': 'CDI',
            'FREELANCE': 'Freelance',
            'CDD': 'CDD',
            'APPRENTICESHIP': 'Alternance',
            'INTERNSHIP': 'Stage',
            'OTHER': 'Autre'
        } %}
        <section class="profile-grid">
            <div class="card"><span>Intitulé de poste</span><strong>{{ profile.title ?? 'À renseigner' }}</strong></div>
            <div class="card"><span>Zone géographique</span><strong>{{ profile.location ?? 'À renseigner' }}</strong></div>
            <div class="card"><span>Expérience</span><strong>{{ profile.yearsOfExperience is not null ? profile.yearsOfExperience ~ ' ans' : 'À renseigner' }}</strong></div>
            <div class="card">
                <span>Contrats recherchés</span>
                <strong>
                    {% if profile.preferredContractTypes is not empty %}
                        {% set formattedContracts = [] %}
                        {% for c in profile.preferredContractTypes %}
                            {% set formattedContracts = formattedContracts|merge([contractLabels[c] ?? c]) %}
                        {% endfor %}
                        {{ formattedContracts|join(', ') }}
                    {% else %}
                        Tous types
                    {% endif %}
                </strong>
            </div>
        </section>

        <details class="profile-edit-disclosure">
            <summary>
                <div>
                    <h3>✏️ Modifier mes critères et ma zone géographique</h3>
                    <p>Ajustez votre intitulé de poste ciblé, votre zone géographique, vos années d’expérience et vos types de contrat souhaités</p>
                </div>
                <span class="disclosure-chevron" aria-hidden="true">▼</span>
            </summary>
            <div class="profile-edit-body">
                {{ form_start(profileDetailsForm, {attr: {class: 'profile-details-form'}}) }}
                    <div class="profile-details-grid">
                        {{ form_row(profileDetailsForm.title) }}
                        {{ form_row(profileDetailsForm.location) }}
                        {{ form_row(profileDetailsForm.yearsOfExperience) }}
                    </div>
                    <div class="profile-details-contracts">
                        <span class="form-section-label">Type(s) de contrat recherché(s)</span>
                        <p class="help-text">Sélectionnez les contrats qui vous correspondent (CDI, Freelance, CDD, Alternance, Stage).</p>
                        <div class="contract-choice-grid">
                            {% for choice in profileDetailsForm.preferredContractTypes %}
                                <label class="contract-choice" for="{{ choice.vars.id }}">
                                    {{ form_widget(choice) }}
                                    <span>{{ choice.vars.label }}</span>
                                </label>
                            {% endfor %}
                        </div>
                        {{ form_errors(profileDetailsForm.preferredContractTypes) }}
                        {% do profileDetailsForm.preferredContractTypes.setRendered %}
                    </div>
                    <div class="profile-details-actions">
                        <button type="submit" class="button">💾 Enregistrer les modifications</button>
                    </div>
                {{ form_end(profileDetailsForm) }}
            </div>
        </details>

        <section class="section skills-section" id="skills" data-controller="skill-filter">
            <div class="section-heading skills-heading">
                <div>
                    <p class="eyebrow">Profil technique</p>
                    <h2>Mes compétences</h2>
                </div>
                <span class="analysis-count" data-skill-filter-target="count">{{ profile.candidateSkills|length }} compétence{{ profile.candidateSkills|length > 1 ? 's' : '' }}</span>
            </div>
            <p class="skills-intro">Ajoutez uniquement les technologies que vous maîtrisez réellement et précisez votre niveau actuel.</p>
            <div id="skill-feedback" aria-live="polite"></div>

            <div class="card form-card skill-add-card">
                <h3>Ajouter une compétence</h3>
                {{ form_start(skillForm, {attr: {class: 'skill-add-form'}}) }}
                    {{ form_row(skillForm.name) }}
                    {{ form_row(skillForm.level) }}
                    {{ form_row(skillForm.category) }}
                    <button type="submit">Ajouter</button>
                {{ form_end(skillForm) }}
            </div>

            {% if profile.candidateSkills|length > 0 %}
                <div class="skill-toolbar">
                    <div class="skill-legend" aria-label="Légende des compétences">
                        <span><i class="skill-swatch skill-swatch-core" aria-hidden="true"></i> Principales</span>
                        <span><i class="skill-swatch" aria-hidden="true"></i> Complémentaires</span>
                    </div>
                    <label class="skill-filter-field" for="skill-level-filter">
                        <span>Filtrer par niveau</span>
                        <select id="skill-level-filter" data-skill-filter-target="level" data-action="change->skill-filter#filter">
                            <option value="">Tous les niveaux</option>
                            <option value="UNSPECIFIED">À préciser</option>
                            {% for skillLevel in skillLevels %}
                                <option value="{{ skillLevel.value }}">{{ skillLevel.label() }}</option>
                            {% endfor %}
                        </select>
                    </label>
                </div>
                <form class="skill-levels-form" method="post" action="{{ path('app_candidate_skill_levels') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('update-skill-levels') }}">
                    <div class="skill-save-bar">
                        <span>Vous pouvez modifier plusieurs niveaux avant d’enregistrer.</span>
                        <button class="button button-compact" type="submit">Enregistrer les modifications</button>
                    </div>
                    <div class="skill-management-list">
                    {% for candidateSkill in profile.candidateSkills %}
                        <article class="skill-management-row {{ candidateSkill.coreSkill ? 'skill-management-row-core' : '' }}" data-skill-filter-target="row" data-skill-level="{{ candidateSkill.level ? candidateSkill.level.value : 'UNSPECIFIED' }}">
                            <div class="skill-identity">
                                <div>
                                    <strong>{{ candidateSkill.skill.name }}</strong>
                                    {% if candidateSkill.coreSkill %}<span class="badge skill-main-badge">Principale</span>{% endif %}
                                </div>
                                <span>{{ candidateSkill.skill.category.label() }}</span>
                            </div>
                            <div class="skill-level-field">
                                <label for="skill-level-{{ candidateSkill.id }}">Niveau</label>
                                <select id="skill-level-{{ candidateSkill.id }}" name="levels[{{ candidateSkill.id }}]">
                                    {% if candidateSkill.level is null %}<option value="" selected disabled>À préciser</option>{% endif %}
                                    {% for skillLevel in skillLevels %}
                                        <option value="{{ skillLevel.value }}" {{ candidateSkill.level == skillLevel ? 'selected' : '' }}>{{ skillLevel.label() }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button class="button danger button-compact" type="submit" form="delete-skill-{{ candidateSkill.id }}" aria-label="Supprimer {{ candidateSkill.skill.name }}">Supprimer</button>
                        </article>
                    {% endfor %}
                    </div>
                    <div class="card empty-skills empty-filtered-skills" data-skill-filter-target="empty" hidden>
                        <p>Aucune compétence ne correspond à ce niveau.</p>
                    </div>
                </form>
                {% for candidateSkill in profile.candidateSkills %}
                    <form id="delete-skill-{{ candidateSkill.id }}" method="post" action="{{ path('app_candidate_skill_delete', {id: candidateSkill.id}) }}" onsubmit="return confirm('Retirer cette compétence de votre profil ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-skill-' ~ candidateSkill.id) }}">
                    </form>
                {% endfor %}
            {% else %}
                <div class="card empty-skills"><p>Aucune compétence enregistrée pour le moment.</p></div>
            {% endif %}
        </section>

    {% else %}
        <section class="card">
            <p>Votre profil sera créé lors du premier dépôt de CV.</p>
            <a class="button" href="{{ path('app_cv_upload') }}">Déposer mon CV</a>
        </section>
    {% endif %}
{% endblock %}
